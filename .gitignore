build_interchanges.py
build_times.py
interchange_new.js
times_new.js
times_new.json

# Local experiments / scratch scripts
centrality_sample.mjs

# build_interchanges generated outputs (live in repo root; not source-of-truth)
interchange_diff.txt
big_changes_ranked.txt

# build_interchanges runtime cache (API responses; auto-regenerable)
build_interchanges/cache/

# build_headways runtime cache (API responses; auto-regenerable)
build_headways/cache/

# build_headways generated outputs (regenerated by each run; not source-of-truth —
# the shipped data is the inlined WAIT_MINS in index.html)
wait_times.js
wait_times_report.txt
wait_times_validate.txt

# build_headways analysis dumps (platform layout research; regenerable, not source)
station_layout.csv
station_shared_platforms.csv

# Ad-hoc test plans / notes
TEST_PLAN_*.md

# Python bytecode
__pycache__/
*.pyc

# VS Code local settings
.vscode/settings.local.json
settings.local.json

# Claude memory
.claude/

# Local safety copies of index.html taken before large engine changes.
# Not deployed, not tracked — but keep them until the change is committed,
# because a pre-change working tree with uncommitted work is NOT recoverable
# from git.
backups/

# Session scratch: throwaway analysis scripts and handoff notes.
scratchpad/
HANDOFF_*.md
