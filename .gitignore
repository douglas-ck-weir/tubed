# macOS
.DS_Store

# Local build tools
build_interchanges.py
build_times.py
interchange_new.js
times_new.js
times_new.json

# Local experiments / scratch scripts
centrality_sample.mjs

# build_interchanges generated outputs (live in repo root; not source-of-truth)
interchange_diff.txt
big_changes_ranked.txt

# build_interchanges runtime cache (API responses; auto-regenerable)
build_interchanges/cache/

# build_headways runtime cache (API responses; auto-regenerable)
build_headways/cache/

# build_headways generated outputs (regenerated by each run; not source-of-truth —
# the shipped data is the inlined WAIT_MINS in index.html)
wait_times.js
wait_times_report.txt
wait_times_validate.txt

# build_headways analysis dumps (platform layout research; regenerable, not source)
station_layout.csv
station_shared_platforms.csv

# Raw reference data downloaded from TfL. Read by hand, not by any code, and
# re-downloadable. Kept out of the repo because this repo IS the deployed
# Pages site: the footfall CSV alone is 10 MB of daily tap counts (235k rows)
# against a 12 MB .git, and it would be served publicly for no benefit.
# The Zone 1-3 pool expansion that used it cites it in index.html.
stationfootfall-*.csv
*Service Intervals and Frequencies.pdf

# Ad-hoc test plans, ship checklists and session notes. These are working
# documents for one change; once it ships the commit and the tests are the
# record. Delete rather than accumulate. (The old TEST_PLAN_* rule missed
# TESTPLAN-* and SHIP-*, so four of them sat untracked for weeks.)
TEST_PLAN_*.md
TESTPLAN-*.md
TESTPLAN_*.md
SHIP-*.md
SHIP_*.md
DEPLOY_*.md
CHECKLIST-*.md
OSI-WALK-CHECKLIST.md

# Python bytecode
__pycache__/
*.pyc

# VS Code local settings
.vscode/settings.local.json
settings.local.json

# Claude memory
.claude/

# Local safety copies of index.html taken before large engine changes.
# Not deployed, not tracked — but keep them until the change is committed,
# because a pre-change working tree with uncommitted work is NOT recoverable
# from git.
backups/

# Session scratch: throwaway analysis scripts and handoff notes.
scratchpad/
HANDOFF_*.md
